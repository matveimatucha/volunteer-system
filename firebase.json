{
  "hosting": {
    "public": "deploy/hosting-redirect",
    "ignore": [
      "firebase.json",
      ".gitignore"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://volonter-msu.ru/",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://volonter-msu.ru/:path",
        "type": 301
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "auth": { "port": 9099 },
    "ui": { "enabled": true }
  }
}
