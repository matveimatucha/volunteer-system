rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Вся запись идёт через серверный API (Cloud Functions, Admin SDK обходит правила).
    // Клиентам оставлено только чтение опубликованных мероприятий — как запасной канал.
    match /events/{eventId} {
      allow read: if resource.data.status != 'draft'
                  && resource.data.isTemplate != true;
      allow write: if false;
    }

    // Заявки содержат персональные данные — доступ только через API.
    match /registrations/{registrationId} {
      allow read, write: if false;
    }
  }
}
