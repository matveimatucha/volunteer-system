rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /registrations/{registrationId} {
      allow read, write: if false;
    }

    match /settings/{docId} {
      allow read, write: if false;
    }
  }
}
