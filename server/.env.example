# Порт HTTP-сервера (сайт + API на одном адресе)
PORT=3000

# Корень статики (HTML/CSS/JS). По умолчанию — родительская папка проекта.
# STATIC_ROOT=..

# Firebase: скачайте JSON-ключ в Console → Project Settings → Service accounts
# → Generate new private key → положите в server/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=volunteer-system-6ce7f

# Google Sheets Apps Script webhook (необязательно)
SHEETS_WEBHOOK_URL=

# Telegram: уведомления о новых регистрациях (необязательно)
# 1. Создайте бота через @BotFather → скопируйте токен
# 2. Напишите боту /start, узнайте chat_id через @userinfobot
# 3. Дополнительные chat_id можно добавить в админке (Firestore)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Если сайт на Firebase Hosting, а API на VPS — укажите origin через запятую:
# ALLOWED_ORIGINS=https://volunteer-system-6ce7f.web.app,https://volunteer-system-6ce7f.firebaseapp.com
